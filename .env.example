# Copy to .env and fill in. .env is gitignored; every service loads it at startup.
# Plain KEY=value, no quotes (the file is read as Java properties).

# DashScope (Alibaba Model Studio) key: chat, embeddings, and the travel MCP tools
API_KEY=
# CHAT_MODEL=qwen3-max

MySQL_USERNAME=root
MySQL_PASSWORD=
NEO4J_PASSWORD=
ELASTIC_PASSWORD=
# ELASTIC_URI=http://localhost:9200

# Google Workspace agent (optional): OAuth client from Google Cloud console, and the account to act as
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_USER_EMAIL=

# Services listen on 127.0.0.1 only. Uncomment to expose on your network (they have no user auth).
# SERVER_ADDRESS=0.0.0.0
